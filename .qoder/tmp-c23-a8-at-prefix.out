    def test_unmatched_signal_must_not_dilute_matched_one():
        """未匹配信号不应稀释已匹配候选者的置信度。
    
        原 bug：total_weight 包含 candidate_id=None 的信号源权重，
        1 路 ARCFACE 匹配 A(0.9) + 1 路 HA_FACE 未匹配 → 置信度从 0.9 被稀释到 0.6。
        修复后：total_weight 只计有匹配的信号源，置信度保持 0.9。
