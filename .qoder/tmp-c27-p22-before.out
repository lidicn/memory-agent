____________ test_concurrent_registration_does_not_lose_an_account ____________

monkeypatch = <_pytest.monkeypatch.MonkeyPatch object at 0x000002DC93597020>

    def test_concurrent_registration_does_not_lose_an_account(monkeypatch):
        """反向不变量：register 的「读 → 改 → 整份写回」在 `AuthManager` 里没有锁，
        靠的就是它在事件循环线程内不被 await 打断。两个并发注册必须都留下来。"""
        class _RmwAuth:
            def __init__(self):
                self.users = {}
    
            def has_users(self):
                return bool(self.users)
    
            def register(self, username, password):
                snapshot = dict(self.users)      # 读
                time.sleep(0.05)                 # 真实实现里是文件 IO，放大窗口用
                snapshot[username] = {"password_hash": "h"}
                self.users = snapshot            # 整份写回（覆盖）
                return {"ok": True, "is_admin": len(snapshot) == 1}
    
            def login(self, username, password):
                return {"ok": True, "token": "t"}
    
        auth = _RmwAuth()
        monkeypatch.setattr(ar, "runtime", lambda request=None: _RT(auth))
    
        async def main():
            await asyncio.gather(
                ar.register(_request({"username": "a", "password": "pw"})),
                ar.register(_request({"username": "b", "password": "pw"})),
            )
    
        asyncio.run(main())
>       assert sorted(auth.users) == ["a", "b"]
E       AssertionError: assert ['a'] == ['a', 'b']
E         
E         Right contains one more item: 'b'
E         Use -v to get more diff

