# ─────────────────────────────────────────────────────────────
# 忆家管家 memory-worker 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# 说明：这些变量只在「配置文件中对应字段为空」时作为初始默认值；
#       一旦你在 WebUI 设置页保存过配置，将以文件 /data/config.json 为准。
# ─────────────────────────────────────────────────────────────

# Home Assistant
HASS_SERVER=http://192.168.2.200:8123
HASS_TOKEN=

# Node-RED（自动化执行）
NR_URL=http://192.168.2.200:1990
NR_USER=lidicn
NR_PASS=

# Redis（去重 / 事件缓冲）
REDIS_HOST=redis
REDIS_PORT=6379

# Chroma 向量库（行为模式 / 语义检索）
CHROMA_HOST=chroma
CHROMA_PORT=8000

# 内置 LLM（OpenAI 兼容接口）
LLM_PROVIDER=openai-compatible
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
TZ_OFFSET_HOURS=8
JWT_SECRET=change_this_to_random_string
DB_PATH=/data/memory_agent.db

# 入口与客户端 IP 口径（DCD 20261007 §五 裁乙）——登录限速按「客户端 IP + 用户名」双桶计数，
# 这个开关决定「客户端 IP」怎么读。
#   关（默认）：一律按 TCP 对端计 IP，完全不读 X-Forwarded-For。经 Caddy 访问时全家人
#              共一个源 IP 桶（5 次失败锁 30 分钟），所以走反代的部署请把它打开。
#   开：仅当请求方 IP ∈ MA_TRUSTED_PROXY_CIDRS 时才取 XFF 末位（反代追加的真实客户端 IP）。
# 网段填 **Caddy 服务名解析出的那一个 IP**（如 172.18.0.7/32），不要用 172.16.0.0/12 整段：
# 信任面越大，能伪造 XFF 的邻居越多。只认 IP/CIDR 字面量，不做服务名解析。
MA_TRUST_PROXY=0
MA_TRUSTED_PROXY_CIDRS=
