# ─────────────────────────────────────────────────────────────
# 忆家管家 memory-worker 环境变量示例
# 复制为 .env 后填入真实值：cp .env.example .env
# 说明：这些变量只在「配置文件中对应字段为空」时作为初始默认值；
#       一旦你在 WebUI 设置页保存过配置，将以文件 /data/config.json 为准。
# ─────────────────────────────────────────────────────────────

# Home Assistant
HASS_SERVER=http://192.168.2.200:8123
HASS_TOKEN=

# Node-RED（自动化执行）
NR_URL=http://192.168.2.200:1990
NR_USER=lidicn
NR_PASS=

# Redis（去重 / 事件缓冲）
REDIS_HOST=redis
REDIS_PORT=6379

# Chroma 向量库（行为模式 / 语义检索）
CHROMA_HOST=chroma
CHROMA_PORT=8000

# 内置 LLM（OpenAI 兼容接口）
LLM_PROVIDER=openai-compatible
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
TZ_OFFSET_HOURS=8
JWT_SECRET=change_this_to_random_string
DB_PATH=/data/memory_worker.db
